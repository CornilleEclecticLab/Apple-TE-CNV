#!/usr/bin/env perl
use strict;
use warnings;
use Getopt::Long qw(GetOptions);
use File::Basename qw(basename dirname);
use File::Path qw(make_path);

# ------------------------------------------------------------
# generate_sortmerna_stampy_jobs.pl
# Reads a list of FASTQ paths, pairs R1/R2, and generates bash
# job scripts (one job handles up to --group-size samples).
#
# Pairing patterns supported:
#   *_R1*.fastq(.gz) <-> *_R2*.fastq(.gz)
#   *_1*.fastq(.gz)  <-> *_2*.fastq(.gz)
#
# Usage:
#   perl scripts/generate_sortmerna_stampy_jobs.pl \
#     --filelist fastq.gz.list \
#     --jobs-dir jobs/sortmerna_stampy \
#     --out-root results/sortmerna_stampy \
#     --sortmerna-ref "/path/db.fasta,/path/db.idx" \
#     --stampy-genome "Malus_db" \
#     --threads 8 \
#     --group-size 20
# ------------------------------------------------------------

my ($filelist, $jobs_dir, $out_root, $sortmerna_ref, $stampy_genome);
my ($threads, $group_size);
$threads    = 4;
$group_size = 20;

GetOptions(
  'filelist=s'      => \$filelist,
  'jobs-dir=s'      => \$jobs_dir,
  'out-root=s'      => \$out_root,
  'sortmerna-ref=s' => \$sortmerna_ref,
  'stampy-genome=s' => \$stampy_genome,
  'threads=i'       => \$threads,
  'group-size=i'    => \$group_size,
) or die "Error in arguments.\n";

die "Missing --filelist\n"      unless $filelist;
die "Missing --jobs-dir\n"      unless $jobs_dir;
die "Missing --out-root\n"      unless $out_root;
die "Missing --sortmerna-ref\n" unless $sortmerna_ref;
die "Missing --stampy-genome\n" unless $stampy_genome;

die "Filelist not found: $filelist\n" unless -f $filelist;

make_path($jobs_dir)  unless -d $jobs_dir;
make_path($out_root)  unless -d $out_root;

# Read FASTQ list
open my $FH, '<', $filelist or die "Cannot open $filelist: $!\n";
my @paths;
while (my $line = <$FH>) {
  chomp $line;
  $line =~ s/\r$//;
  next if $line =~ /^\s*$/;
  push @paths, $line;
}
close $FH;

die "No FASTQ paths found in $filelist\n" unless @paths;

# Pairing
my %pairs;  # sample_id => { R1=>..., R2=>... }
for my $p (@paths) {
  my $b = basename($p);

  my ($sample, $mate);

  if ($b =~ /(.*?)(_R[12])(.*)\.(fastq|fq)(\.gz)?$/i) {
    $sample = $1 . $3;                 # keep the rest but remove _R1/_R2
    $mate   = $2;                      # _R1 or _R2
  } elsif ($b =~ /(.*?)(_?[12])(.*)\.(fastq|fq)(\.gz)?$/i) {
    # This is more permissive: sample_1 / sample_2
    # We only accept if it looks like a mate marker near the end
    $sample = $1 . $3;
    $mate   = $2;
    # normalize to _1/_2 if it was "1" or "_1"
    $mate = "_$mate" if $mate eq "1" || $mate eq "2";
  } else {
    warn "[WARN] Unrecognized FASTQ naming, skipping: $b\n";
    next;
  }

  if ($mate eq "_R1" || $mate eq "_1") {
    $pairs{$sample}{R1} = $p;
  } elsif ($mate eq "_R2" || $mate eq "_2") {
    $pairs{$sample}{R2} = $p;
  } else {
    warn "[WARN] Unrecognized mate token ($mate) for: $b\n";
  }
}

# Keep only complete pairs
my @samples;
for my $s (sort keys %pairs) {
  next unless $pairs{$s}{R1} && $pairs{$s}{R2};
  push @samples, $s;
}

die "No complete R1/R2 pairs found. Check naming (_R1/_R2 or _1/_2).\n" unless @samples;

print "[OK] Found ", scalar(@samples), " paired sample(s).\n";

# Split samples into chunks
my $job_idx = 0;
for (my $i = 0; $i < @samples; $i += $group_size) {
  $job_idx++;
  my $job_name = sprintf("job_%03d.sortmerna_stampy.sh", $job_idx);
  my $job_path = "$jobs_dir/$job_name";

  open my $SH, '>', $job_path or die "Cannot write $job_path: $!\n";

  print $SH <<"BASH";
#!/usr/bin/env bash
set -euo pipefail

# Auto-generated by generate_sortmerna_stampy_jobs.pl
# Job: $job_name
# Threads: $threads
# SortMeRNA ref: $sortmerna_ref
# Stampy genome: $stampy_genome
#
# NOTE:
# - Make sure 'sortmerna' and 'stampy.py' are available in PATH.
# - Adjust the commands below if your installation requires extra flags.

THREADS=$threads
SORTMERNA_REF="$sortmerna_ref"
STAMPY_GENOME="$stampy_genome"
OUTROOT="$out_root"

mkdir -p "\$OUTROOT"

BASH

  # Write per-sample commands
  my $end = $i + $group_size - 1;
  $end = $#samples if $end > $#samples;

  for my $j ($i..$end) {
    my $s = $samples[$j];
    my $r1 = $pairs{$s}{R1};
    my $r2 = $pairs{$s}{R2};

    # sanitize sample folder name a bit
    (my $safe = $s) =~ s/[^A-Za-z0-9._-]+/_/g;

    print $SH <<"BASH";

echo "[INFO] ------------------------------------------------------------"
echo "[INFO] Sample: $safe"
R1="$r1"
R2="$r2"
SAMPLE_DIR="\$OUTROOT/$safe"
mkdir -p "\$SAMPLE_DIR"

# 1) SortMeRNA (rRNA filtering)
# This is a minimal generic command; adapt if your workflow uses different flags.
sortmerna \\
  --ref "\$SORTMERNA_REF" \\
  --reads "\$R1" \\
  --reads "\$R2" \\
  --workdir "\$SAMPLE_DIR/sortmerna_work" \\
  --threads "\$THREADS" \\
  --fastx \\
  --other "\$SAMPLE_DIR/${safe}_non_rRNA.fastq"

# 2) Stampy mapping
# Stampy can take paired reads; here we map the non-rRNA output as single file.
# If your output produces separate mates, edit accordingly.
stampy.py \\
  -g "\$STAMPY_GENOME" \\
  -h "\$STAMPY_GENOME" \\
  -t "\$THREADS" \\
  -M "\$SAMPLE_DIR/${safe}_non_rRNA.fastq" \\
  -o "\$SAMPLE_DIR/${safe}.stampy.sam"

echo "[OK] Done sample: $safe"
BASH
  }

  print $SH "\necho \"[OK] Job completed: $job_name\"\n";
  close $SH;

  chmod 0755, $job_path;
  print "[OK] Wrote $job_path\n";
}

print "[OK] All jobs generated in: $jobs_dir\n";